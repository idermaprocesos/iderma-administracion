<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="IdermaAdministracion.Dialogos.AgregarPersonaDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Guardar_Click"
    PrimaryButtonText="Agregar"
    Title="Agregar persona">
    <StackPanel Width="420" Spacing="12">
        <TextBlock x:Name="AreaTexto" Opacity="0.8" TextWrapping="Wrap" />
        <TextBox x:Name="Nombres" Header="Nombres" PlaceholderText="Nombre" />
        <TextBox x:Name="Apellidos" Header="Apellidos" PlaceholderText="Apellidos" />
        <TextBox x:Name="Cargo" Header="Cargo" PlaceholderText="Cargo en el área" />
        <ComboBox x:Name="RolCombo" HorizontalAlignment="Stretch" Header="Tipo" SelectedIndex="0">
            <ComboBoxItem Content="Trabajador" />
            <ComboBoxItem Content="Doctor" />
        </ComboBox>
        <InfoBar
            x:Name="Aviso"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />
    </StackPanel>
</ContentDialog>
