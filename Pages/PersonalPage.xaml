<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaAdministracion.Pages.PersonalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:IdermaAdministracion.Models"
    NavigationCacheMode="Enabled">

    <Grid Padding="28,20,28,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="Titulo" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="Subtitulo" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Name="BotonAgregar"
                Grid.Column="1"
                VerticalAlignment="Top"
                Click="Agregar_Click"
                Content="Agregar" />
        </Grid>

        <InfoBar
            x:Name="AvisoVencimiento"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <AutoSuggestBox
                x:Name="BuscarBox"
                HorizontalAlignment="Stretch"
                PlaceholderText="Buscar nombre, documento, área o cargo"
                TextChanged="BuscarBox_TextChanged">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="FiltroEstado"
                    MinWidth="0"
                    HorizontalAlignment="Stretch"
                    Header="Estado"
                    SelectedIndex="0"
                    SelectionChanged="Filtro_SelectionChanged">
                    <ComboBoxItem Content="Todos" />
                    <ComboBoxItem Content="Activos" />
                    <ComboBoxItem Content="Retirados" />
                    <ComboBoxItem Content="Por vencer" />
                </ComboBox>
                <ComboBox
                    x:Name="FiltroPago"
                    Grid.Column="1"
                    MinWidth="0"
                    HorizontalAlignment="Stretch"
                    Header="Pago"
                    SelectedIndex="0"
                    SelectionChanged="Filtro_SelectionChanged">
                    <ComboBoxItem Content="Todos" />
                    <ComboBoxItem Content="Planilla" />
                    <ComboBoxItem Content="Recibo por honorarios" />
                </ComboBox>
                <ComboBox
                    x:Name="FiltroImagen"
                    Grid.Column="2"
                    MinWidth="0"
                    HorizontalAlignment="Stretch"
                    Header="Imagen"
                    SelectedIndex="0"
                    SelectionChanged="Filtro_SelectionChanged">
                    <ComboBoxItem Content="Todos" />
                    <ComboBoxItem Content="Autoriza" />
                    <ComboBoxItem Content="No autoriza" />
                </ComboBox>
            </Grid>
        </Grid>

        <Grid Grid.Row="3">
            <ListView
                x:Name="Lista"
                IsItemClickEnabled="True"
                ItemClick="Lista_ItemClick"
                Padding="2,2,8,8"
                ItemContainerStyle="{StaticResource FilaListaEstilo}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:Colaborador">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PersonPicture
                                    Width="48"
                                    Height="48"
                                    VerticalAlignment="Center"
                                    DisplayName="{x:Bind NombreCompleto}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind NombreCompleto}" />
                                    <TextBlock Opacity="0.85" Text="{x:Bind AreaCargo}" />
                                    <TextBlock FontSize="12" Opacity="0.7" Text="{x:Bind ResumenLista}" TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Text="{x:Bind Contrato.AlertaVencimiento}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind Contrato.VisibilidadAlerta}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{x:Bind Contrato.SueldoTexto}" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                        <Border Padding="8,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                                            <TextBlock FontSize="12" Text="{x:Bind EstadoTexto}" />
                                        </Border>
                                        <Border Padding="8,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                                            <TextBlock FontSize="12" Text="{x:Bind Contrato.ModalidadTexto}" />
                                        </Border>
                                        <Border Padding="8,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                                            <TextBlock FontSize="12" Text="{x:Bind FirmasTexto}" />
                                        </Border>
                                    </StackPanel>
                                    <FontIcon
                                        HorizontalAlignment="Right"
                                        FontSize="14"
                                        Glyph="&#xE76C;"
                                        Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                x:Name="Vacio"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6"
                Visibility="Collapsed">
                <TextBlock HorizontalAlignment="Center" Text="Ningún registro coincide con el filtro." />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
