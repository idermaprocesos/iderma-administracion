<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="IdermaAdministracion.Dialogos.EditorPuestoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Guardar_Click"
    PrimaryButtonText="Crear puesto"
    Title="Nuevo puesto de trabajo">
    <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="560" Spacing="12">
            <TextBox x:Name="Nombre" Header="Puesto" PlaceholderText="Recepcionista" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="Area" HorizontalAlignment="Stretch" Header="Área" />
                <ComboBox x:Name="Rol" Grid.Column="1" HorizontalAlignment="Stretch" Header="Tipo" SelectedIndex="0">
                    <ComboBoxItem Content="Trabajador" />
                    <ComboBoxItem Content="Doctor" />
                </ComboBox>
            </Grid>
            <TextBox
                x:Name="Funciones"
                AcceptsReturn="True"
                Header="Funciones"
                MinHeight="72"
                PlaceholderText="Qué hace la persona en el día a día"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="Estudios"
                AcceptsReturn="True"
                Header="Estudios"
                MinHeight="72"
                PlaceholderText="Formación o títulos que se piden"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="Responsabilidades"
                AcceptsReturn="True"
                Header="Responsabilidades"
                MinHeight="72"
                PlaceholderText="De qué responde el puesto"
                TextWrapping="Wrap" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <NumberBox
                    x:Name="SueldoDesde"
                    Header="Sueldo desde (S/)"
                    HorizontalAlignment="Stretch"
                    Minimum="0"
                    PlaceholderText="0"
                    SpinButtonPlacementMode="Compact" />
                <NumberBox
                    x:Name="SueldoHasta"
                    Grid.Column="1"
                    Header="Sueldo hasta (S/)"
                    HorizontalAlignment="Stretch"
                    Minimum="0"
                    PlaceholderText="0"
                    SpinButtonPlacementMode="Compact" />
            </Grid>
            <InfoBar
                x:Name="Aviso"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
