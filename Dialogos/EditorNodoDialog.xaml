<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="IdermaAdministracion.Dialogos.EditorNodoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Guardar_Click"
    PrimaryButtonText="Guardar"
    Title="Editar nodo">
    <StackPanel Width="520" Spacing="12">
        <TextBlock
            Opacity="0.8"
            Text="Cambia el nombre y el cargo, quita a alguien o agrega otra persona. El cambio se conserva mientras la aplicación sigue abierta."
            TextWrapping="Wrap" />
        <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="Filas" Spacing="10" />
        </ScrollViewer>
        <Button HorizontalAlignment="Left" Click="Agregar_Click" Content="Agregar persona" />
        <InfoBar
            x:Name="Aviso"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />
    </StackPanel>
</ContentDialog>
