<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaAdministracion.Pages.OrdenServicioEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:IdermaAdministracion.Models">

    <Grid Padding="24,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button VerticalAlignment="Center" Click="Volver_Click" Content="Volver" />
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Orden de servicio" />
                <TextBlock
                    Opacity="0.75"
                    Text="FO0ADM016 · Ampliación de contratos por meses. El importe usa el sueldo mensual con IGV incluido."
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock
                x:Name="ResumenLineas"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="0 contratos" />
        </Grid>

        <InfoBar
            x:Name="Aviso"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False" />

        <Grid Grid.Row="2" ColumnSpacing="10" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CajaMes" Header="Mes / Año" />
            <CalendarDatePicker
                x:Name="FechaElaboracion"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Header="Fecha de elaboración" />
            <TextBox x:Name="CajaCobertura" Grid.Column="2" Header="Período de cobertura" />
            <ComboBox
                x:Name="ComboEstado"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                Header="Estado" />
            <TextBox
                x:Name="CajaElaborado"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Header="Elaborado por"
                PlaceholderText="Nombre de quien elabora" />
            <TextBox
                x:Name="CajaRevisado"
                Grid.Row="1"
                Grid.Column="2"
                Grid.ColumnSpan="2"
                Header="Revisado por"
                PlaceholderText="Nombre de quien revisa" />
        </Grid>

        <AutoSuggestBox
            x:Name="BuscarPersona"
            Grid.Row="3"
            PlaceholderText="Agregar colaborador: nombre, documento o cargo"
            QueryIcon="Find"
            SuggestionChosen="BuscarPersona_SuggestionChosen"
            TextChanged="BuscarPersona_TextChanged" />

        <ListView x:Name="Lista" Grid.Row="4" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:LineaOrdenServicio">
                    <Grid Padding="4,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Nombre}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Opacity="0.7" Text="{x:Bind Resumen}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind TextoContrato}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind TextoVence}" />
                        <NumberBox
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Header="Meses"
                            LargeChange="1"
                            Maximum="36"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind MesesAmpliar, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Text="{x:Bind TextoNuevaVigencia, Mode=OneWay}" />
                        <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{x:Bind TextoIgv, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="6"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind TextoTotal, Mode=OneWay}" />
                        <Button
                            Grid.Column="7"
                            VerticalAlignment="Center"
                            Click="Quitar_Click"
                            Content="Quitar"
                            Tag="{x:Bind ColaboradorId}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="5" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TotalGeneral"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Total con IGV: —"
                TextWrapping="Wrap" />
            <Button Grid.Column="1" MinWidth="120" Click="Guardar_Click" Content="Guardar" />
            <Button
                Grid.Column="2"
                MinWidth="140"
                Click="Pdf_Click"
                Content="Imprimir PDF"
                Style="{StaticResource AccentButtonStyle}" />
            <Button Grid.Column="3" MinWidth="140" Click="Excel_Click" Content="Exportar Excel" />
        </Grid>
    </Grid>
</Page>
