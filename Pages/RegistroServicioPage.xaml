<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaAdministracion.Pages.RegistroServicioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IdermaAdministracion.Pages">

    <Grid Padding="28,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <Button HorizontalAlignment="Left" Click="Volver_Click" Content="Volver" />
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Órdenes de servicio anteriores" />
            <TextBlock
                Opacity="0.75"
                Text="Vuelva a imprimir una orden en PDF o descárguela en Excel."
                TextWrapping="Wrap" />
        </StackPanel>
        <InfoBar x:Name="Aviso" Grid.Row="1" IsClosable="True" IsOpen="False" />
        <Grid Grid.Row="2">
            <TextBlock
                x:Name="Vacio"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.72"
                Text="Aún no hay órdenes de servicio."
                TextWrapping="Wrap" />
            <ListView x:Name="Lista" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:OrdenServicioItem">
                        <Grid Padding="4,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Titulo}" />
                                <TextBlock Opacity="0.75" Text="{x:Bind Resumen}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Click="Pdf_Click" Content="PDF" Tag="{x:Bind IdTexto}" />
                                <Button Click="Excel_Click" Content="Excel" Tag="{x:Bind IdTexto}" />
                                <Button Click="Quitar_Click" Content="Quitar" Tag="{x:Bind IdTexto}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
