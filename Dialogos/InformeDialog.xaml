<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="IdermaAdministracion.Dialogos.InformeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cerrar"
    Title="Informe de situación laboral">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
    </ContentDialog.Resources>

    <Grid Width="740" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="420" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            Opacity="0.8"
            Text="Informe redactado con la información del expediente. Cada documento se explica y se indica cuándo fue firmado."
            TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="Cuerpo" Spacing="12" />
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <InfoBar x:Name="Aviso" IsClosable="True" IsOpen="False" />
            <Button Grid.Column="1" Click="Word_Click" Content="Exportar Word" />
            <Button Grid.Column="2" Click="Pdf_Click" Content="Exportar PDF" />
        </Grid>
    </Grid>
</ContentDialog>
