<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="IdermaAdministracion.Dialogos.EditorPostulacionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Guardar_Click"
    PrimaryButtonText="Crear"
    Title="Nueva postulación">
    <StackPanel Spacing="12" Width="420">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Nombres" Header="Nombres" PlaceholderText="Nombre" />
            <TextBox x:Name="Apellidos" Grid.Column="1" Header="Apellidos" PlaceholderText="Apellidos" />
        </Grid>
        <TextBox x:Name="Documento" Header="Documento" PlaceholderText="DNI" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Telefono" Header="Teléfono" PlaceholderText="999 000 000" />
            <TextBox x:Name="Correo" Grid.Column="1" Header="Correo" PlaceholderText="correo@ejemplo.com" />
        </Grid>
        <ComboBox x:Name="Puesto" HorizontalAlignment="Stretch" Header="Puesto al que postula" />
        <ComboBox x:Name="Area" HorizontalAlignment="Stretch" Header="Área" />
        <ComboBox x:Name="Rol" HorizontalAlignment="Stretch" Header="Tipo" SelectedIndex="0">
            <ComboBoxItem Content="Trabajador" />
            <ComboBoxItem Content="Doctor" />
        </ComboBox>
        <InfoBar
            x:Name="Aviso"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />
    </StackPanel>
</ContentDialog>
