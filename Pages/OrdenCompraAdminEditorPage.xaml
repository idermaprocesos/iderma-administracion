<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaAdministracion.Pages.OrdenCompraAdminEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:IdermaAdministracion.Models">

    <Grid Padding="24,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button VerticalAlignment="Center" Click="Volver_Click" Content="Volver" />
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Orden de compra" />
                <TextBlock Opacity="0.75" Text="FO0ADM015 · Compras. El precio de cada línea se toma con IGV incluido." TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="Aviso" Grid.Row="1" IsClosable="True" IsOpen="False" />

        <Grid Grid.Row="2" ColumnSpacing="10" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CajaMes" Header="Mes / Año" />
            <CalendarDatePicker x:Name="FechaElaboracion" Grid.Column="1" HorizontalAlignment="Stretch" Header="Fecha de elaboración" />
            <TextBox x:Name="CajaProveedor" Grid.Column="2" Header="Proveedor" />
            <ComboBox x:Name="ComboEstado" Grid.Column="3" HorizontalAlignment="Stretch" Header="Estado" />
            <TextBox x:Name="CajaCobertura" Grid.Row="1" Header="Período de cobertura" />
            <TextBox x:Name="CajaElaborado" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Header="Elaborado por" />
            <TextBox x:Name="CajaRevisado" Grid.Row="1" Grid.Column="3" Header="Revisado por" />
        </Grid>

        <Button Grid.Row="3" HorizontalAlignment="Left" Click="Agregar_Click" Content="Agregar línea" />

        <ListView x:Name="Lista" Grid.Row="4" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:LineaOrdenCompraAdmin">
                    <Grid Padding="0,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Header="Descripción" Text="{x:Bind Descripcion, Mode=TwoWay}" />
                        <NumberBox Grid.Column="1" Header="Cantidad" Minimum="0" SpinButtonPlacementMode="Compact" Value="{x:Bind Cantidad, Mode=TwoWay}" />
                        <TextBox Grid.Column="2" Header="Und." Text="{x:Bind Unidad, Mode=TwoWay}" />
                        <NumberBox Grid.Column="3" Header="Precio con IGV" Minimum="0" SpinButtonPlacementMode="Compact" Value="{x:Bind PrecioConIgv, Mode=TwoWay}" />
                        <ComboBox Grid.Column="4" Header="Tipo" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Tipos}" SelectedItem="{x:Bind TipoPrecio, Mode=TwoWay}" />
                        <TextBlock Grid.Column="5" VerticalAlignment="Bottom" FontWeight="SemiBold" Text="{x:Bind TextoTotal, Mode=OneWay}" />
                        <Button Grid.Column="6" VerticalAlignment="Bottom" Click="Quitar_Click" Content="Quitar" Tag="{x:Bind Id}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="5" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TotalGeneral" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Total con IGV: —" />
            <Button Grid.Column="1" Click="Guardar_Click" Content="Guardar" />
            <Button Grid.Column="2" Click="Pdf_Click" Content="Imprimir PDF" Style="{StaticResource AccentButtonStyle}" />
            <Button Grid.Column="3" Click="Excel_Click" Content="Exportar Excel" />
        </Grid>
    </Grid>
</Page>
