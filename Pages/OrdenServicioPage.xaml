<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaAdministracion.Pages.OrdenServicioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IdermaAdministracion.Pages">

    <Grid Padding="28,20,28,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Orden de servicio" />
            <TextBlock
                Opacity="0.8"
                Text="Sección aparte de la orden de compra. Marque contratos y amplíelos por meses. Puede guardar, revisar e imprimir en PDF o Excel."
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="CajaBusqueda"
                PlaceholderText="Buscar nombre, documento, cargo, área o contrato"
                TextChanged="CajaBusqueda_TextChanged" />
            <ComboBox
                x:Name="FiltroEstado"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Header="Contrato"
                SelectedIndex="0"
                SelectionChanged="Filtro_Changed">
                <ComboBoxItem Content="Todos" />
                <ComboBoxItem Content="Activos" />
                <ComboBoxItem Content="Por vencer" />
                <ComboBoxItem Content="Vencidos" />
            </ComboBox>
            <ComboBox
                x:Name="FiltroPago"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Header="Pago"
                SelectedIndex="0"
                SelectionChanged="Filtro_Changed">
                <ComboBoxItem Content="Todos" />
                <ComboBoxItem Content="Planilla" />
                <ComboBoxItem Content="Recibo por honorarios" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="ResumenMarcas"
                VerticalAlignment="Center"
                Opacity="0.75"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="1"
                Click="Generar_Click"
                Content="Generar orden de servicio"
                Style="{StaticResource AccentButtonStyle}" />
            <Button Grid.Column="2" Click="Borradores_Click" Content="Editar borradores" />
            <Button Grid.Column="3" Click="Anteriores_Click" Content="Órdenes anteriores" />
        </Grid>

        <ListView x:Name="Lista" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ContratoServicioItem">
                    <Grid Padding="4,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            VerticalAlignment="Center"
                            Click="Marca_Click"
                            IsChecked="{x:Bind Marcado, Mode=TwoWay}"
                            Tag="{x:Bind Id}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Nombre}" />
                            <TextBlock Opacity="0.7" Text="{x:Bind Resumen}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Contrato}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Vigencia}" />
                        <TextBlock
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            FontWeight="SemiBold"
                            Text="{x:Bind Mensual}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar
            x:Name="Aviso"
            Grid.Row="4"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Page>
